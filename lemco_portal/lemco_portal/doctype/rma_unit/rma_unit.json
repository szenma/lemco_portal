  {"fieldname": "received_date", "fieldtype": "Date", "label": "Received Date"},
  {"fieldname": "received_by", "fieldtype": "Link", "label": "Received By", "options": "User"},
  {"fieldname": "column_break_receiving", "fieldtype": "Column Break"},
  {"fieldname": "physical_condition", "fieldtype": "Small Text", "label": "Physical Condition"},
  {"fieldname": "accessories_received", "fieldtype": "Data", "label": "Accessories Received"},
  {"fieldname": "receiving_notes", "fieldtype": "Small Text", "label": "Receiving Notes", "description": "Record discrepancies here (different qty/product/identifier, missing/unexpected accessory, damage) - never edit the customer's original declaration on the RMA Item."},

  {"fieldname": "section_break_tech", "fieldtype": "Section Break", "label": "Technician & Coverage"},
  {"fieldname": "technician", "fieldtype": "Link", "label": "Technician", "options": "User", "in_list_view": 1, "description": "Same person handles identification, diagnosis, repair, testing, and QC for this unit - no separate QC technician in V1."},
  {"fieldname": "service_coverage", "fieldtype": "Select", "label": "Service Coverage", "options": "Pending Decision\nWarranty\nNon-Warranty\nGoodwill\nNot Applicable", "default": "Pending Decision", "in_list_view": 1, "description": "Manual Lemco decision - no ERPNext Warranty system is used."},
  {"fieldname": "column_break_tech", "fieldtype": "Column Break"},
  {"fieldname": "repair_started_on", "fieldtype": "Datetime", "label": "Repair Started On"},
  {"fieldname": "repair_completed_on", "fieldtype": "Datetime", "label": "Repair Completed On"},
  {"fieldname": "coverage_notes", "fieldtype": "Small Text", "label": "Coverage Notes"},

  {"fieldname": "section_break_diag", "fieldtype": "Section Break", "label": "Diagnosis"},
  {"fieldname": "internal_diagnosis", "fieldtype": "Text", "label": "Internal Diagnosis", "description": "Never exposed to the customer."},
  {"fieldname": "customer_visible_diagnosis", "fieldtype": "Text", "label": "Customer Visible Diagnosis"},

  {"fieldname": "section_break_repair", "fieldtype": "Section Break", "label": "Repair"},
  {"fieldname": "internal_repair_notes", "fieldtype": "Text", "label": "Internal Repair Notes"},
  {"fieldname": "customer_work_performed", "fieldtype": "Text", "label": "Customer Work Performed"},
  {"fieldname": "repair_parts", "fieldtype": "Table", "label": "Repair Parts", "options": "RMA Repair Part"},

  {"fieldname": "section_break_charge", "fieldtype": "Section Break", "label": "Chargeable Repair"},
  {"fieldname": "customer_repair_price", "fieldtype": "Currency", "label": "Customer Repair Price", "depends_on": "eval:doc.service_coverage=='Non-Warranty'"},
  {"fieldname": "customer_visible_comments", "fieldtype": "Text", "label": "Customer Visible Comments"},
  {"fieldname": "quotation_reference", "fieldtype": "Data", "label": "Quotation Reference", "description": "Optional manual reference - no automatic commercial document is created."},
  {"fieldname": "column_break_charge", "fieldtype": "Column Break"},
  {"fieldname": "repair_decision", "fieldtype": "Select", "label": "Repair Decision", "options": "Pending\nApproved\nDeclined", "default": "Pending", "read_only": 1},
  {"fieldname": "repair_decision_by", "fieldtype": "Link", "label": "Repair Decision By", "options": "User", "read_only": 1},
  {"fieldname": "repair_decision_on", "fieldtype": "Datetime", "label": "Repair Decision On", "read_only": 1},
  {"fieldname": "approved_amount_snapshot", "fieldtype": "Currency", "label": "Approved Amount Snapshot", "read_only": 1, "description": "Frozen at the moment of approval - later edits to Customer Repair Price never change this."},
  {"fieldname": "approval_text_snapshot", "fieldtype": "Text", "label": "Approval Text Snapshot", "read_only": 1, "description": "Frozen copy of the customer-visible proposal exactly as shown at approval time."},

  {"fieldname": "section_break_test", "fieldtype": "Section Break", "label": "Testing & Resolution"},
  {"fieldname": "test_notes", "fieldtype": "Text", "label": "Test Notes"},
  {"fieldname": "customer_test_notes", "fieldtype": "Text", "label": "Customer Test Notes"},
  {"fieldname": "qc_result", "fieldtype": "Select", "label": "QC Result", "options": "Pending\nPass\nFail\nNot Applicable", "default": "Pending"},
  {"fieldname": "column_break_test", "fieldtype": "Column Break"},
  {"fieldname": "resolution", "fieldtype": "Select", "label": "Resolution", "options": "\nRepaired\nNo Fault Found\nUnrepairable\nReplacement\nReturned Unrepaired"},
  {"fieldname": "resolution_explanation", "fieldtype": "Text", "label": "Resolution Explanation", "description": "Customer-visible - shown for No Fault Found / Unrepairable / Replacement / Returned Unrepaired."},

  {"fieldname": "section_break_replace", "fieldtype": "Section Break", "label": "Replacement", "depends_on": "eval:doc.resolution=='Replacement'"},
  {"fieldname": "original_product", "fieldtype": "Link", "label": "Original Product", "options": "Item"},
  {"fieldname": "original_identifier", "fieldtype": "Data", "label": "Original Identifier"},
  {"fieldname": "column_break_replace", "fieldtype": "Column Break"},
  {"fieldname": "replacement_product", "fieldtype": "Link", "label": "Replacement Product", "options": "Item"},
  {"fieldname": "replacement_serial_lot_no", "fieldtype": "Data", "label": "Replacement Serial/LOT No."},
  {"fieldname": "replacement_notes", "fieldtype": "Small Text", "label": "Replacement Notes"},

  {"fieldname": "section_break_complete", "fieldtype": "Section Break", "label": "Technical Completion"},
  {"fieldname": "technical_complete", "fieldtype": "Check", "label": "Technical Complete", "read_only": 1},
  {"fieldname": "technical_completed_by", "fieldtype": "Link", "label": "Technical Completed By", "options": "User", "read_only": 1},
  {"fieldname": "technical_completed_on", "fieldtype": "Datetime", "label": "Technical Completed On", "read_only": 1}
