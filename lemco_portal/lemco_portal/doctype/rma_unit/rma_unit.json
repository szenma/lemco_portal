 "fields": [
  {"fieldname": "rma", "fieldtype": "Link", "label": "RMA", "options": "RMA", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "source_item_code", "fieldtype": "Link", "label": "Declared Product", "options": "Item", "description": "Copied from the RMA Item this unit was created from."},
  {"fieldname": "customer_serial_lot_no", "fieldtype": "Data", "label": "Customer Serial/LOT No. (as declared)", "read_only": 1, "description": "Never overwritten - preserves the customer's original declaration alongside Lemco's verified identification below."},

  {"fieldname": "section_break_id", "fieldtype": "Section Break", "label": "Identification"},
  {"fieldname": "actual_product", "fieldtype": "Link", "label": "Actual Product", "options": "Item", "in_list_view": 1},
  {"fieldname": "identification_type", "fieldtype": "Select", "label": "Identification Type", "options": "\nSerial Number\nLOT Number\nBoth\nNo Identification\nOther"},
  {"fieldname": "column_break_id", "fieldtype": "Column Break"},
  {"fieldname": "verified_serial_no", "fieldtype": "Data", "label": "Verified Serial No."},
